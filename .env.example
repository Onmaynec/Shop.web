DATABASE_URL="postgresql://standoffshop:standoffshop@localhost:5432/standoffshop?schema=public"
# Set a unique random value >= 32 characters. Never commit a real .env file.
SESSION_SECRET="replace-with-at-least-32-random-characters-before-running"

# Development-only test provider; real payments are NOT connected.
# Enable only for LOCAL TESTING. Always disabled when NODE_ENV=production.
PAYMENT_SANDBOX_ENABLED="false"
# When enabling sandbox, use a separate random secret >= 32 characters.
PAYMENT_SANDBOX_SECRET=""

# Reverse proxy IP headers are trusted ONLY when all external requests pass
# through a proxy which removes client-supplied X-Forwarded-For.
TRUST_PROXY_HEADERS="false"

# Local media persistence. Optional; default is ./data/media.
# On a self-hosted server, point to a dedicated persistent directory.
# MEDIA_STORAGE_DIR="D:/standoffshop/media"

# v0.8.0 private digital deliverables. Must remain OUTSIDE public/,
# on persistent storage protected by operating-system file permissions.
# PRIVATE_DELIVERY_DIR="D:/standoffshop/private-deliveries"

# v1.0.0 / Optional server-side staff MFA policy.
# FIRST enroll TOTP for all staff in /account/security, THEN set this to true.
# When true, staff without MFA can still sign in to enroll but lose privileged access.
ENFORCE_STAFF_MFA="false"
