DATABASE_URL="postgresql://standoffshop:standoffshop@localhost:5432/standoffshop?schema=public"
# Set a unique random value >= 32 characters. Never commit a real .env file.
SESSION_SECRET="replace-with-at-least-32-random-characters-before-running"

# Development-only test provider; real payments are NOT connected.
# Enable only for LOCAL TESTING. Always disabled when NODE_ENV=production.
PAYMENT_SANDBOX_ENABLED="false"
# When enabling sandbox, use a separate random secret >= 32 characters.
PAYMENT_SANDBOX_SECRET=""
